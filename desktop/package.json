{
  "name": "transcriptor",
  "version": "1.3.9",
  "description": "Voice-to-text transcription with auto-paste",
  "author": "Leo Erdman",
  "license": "MIT",
  "homepage": "https://github.com/UltraDeepAutomation/Voice-Transcriptor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UltraDeepAutomation/Voice-Transcriptor.git"
  },
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "node --test",
    "build:frontend": "npm --prefix ../frontend run build",
    "dist": "bash ./scripts/prepare-runtime.sh mac-arm64 && node ./unlockDist.js && npm run build:frontend && electron-builder --mac dmg --arm64",
    "dist:dir": "bash ./scripts/prepare-runtime.sh mac-arm64 && node ./unlockDist.js && npm run build:frontend && electron-builder --mac --dir --arm64",
    "dist:adhoc": "bash ./scripts/prepare-runtime.sh mac-arm64 && node ./unlockDist.js && npm run build:frontend && TRANSCRIPTOR_ALLOW_ADHOC_SIGN=1 electron-builder --mac dmg --arm64",
    "dist:dir:adhoc": "bash ./scripts/prepare-runtime.sh mac-arm64 && node ./unlockDist.js && npm run build:frontend && TRANSCRIPTOR_ALLOW_ADHOC_SIGN=1 electron-builder --mac --dir --arm64",
    "notarize:dmg": "bash ./scripts/notarize-dmg.sh",
    "dist:mas": "bash ./scripts/build-mas.sh",
    "testflight:upload": "bash ./scripts/upload-testflight.sh",
    "dist:win": "node ./scripts/require-bash.js win-x64 && bash ./scripts/prepare-runtime.sh win-x64 && node ./unlockDist.js && npm run build:frontend && electron-builder --win --x64",
    "dist:linux": "bash ./scripts/prepare-runtime.sh linux-x64 && node ./unlockDist.js && npm run build:frontend && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.4.0",
    "electron": "42.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "copyright": "Copyright (c) 2026 Leo Erdman. Licensed under the MIT License.",
    "appId": "local.transcriptor.app",
    "productName": "Transcriptor",
    "afterPack": "./afterPack.js",
    "afterAllArtifactBuild": "./afterAllArtifactBuild.js",
    "files": [
      "main.js",
      "accelerator.js",
      "engine-deps.js",
      "preload.js",
      "shortcut-defaults.json",
      "package.json",
      "icon.png",
      "icon.ico",
      "!runtime/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.ruff_cache/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../requirements-gigaam.txt",
        "to": "requirements-gigaam.txt"
      },
      {
        "from": "../ENABLE_GIGAAM",
        "to": "ENABLE_GIGAAM"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright (c) 2026 Leo Erdman. Licensed under the MIT License.",
        "NSMicrophoneUsageDescription": "Transcriptor records microphone audio when you start a live transcription.",
        "NSAppleEventsUsageDescription": "Transcriptor uses Apple Events to paste transcripts into the app you are working in."
      },
      "extraResources": [
        {
          "from": "runtime/mac-${arch}",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "../requirements-gigaam.txt",
          "to": "requirements-gigaam.txt"
        },
        {
          "from": "../ENABLE_GIGAAM",
          "to": "ENABLE_GIGAAM"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "background": "build/dmg-background.png",
      "iconSize": 104,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 178,
          "y": 220,
          "type": "file"
        },
        {
          "x": 482,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    },
    "mas": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "identity": null,
      "entitlements": "entitlements.mas.plist",
      "entitlementsInherit": "entitlements.mas.inherit.plist",
      "hardenedRuntime": true,
      "preAutoEntitlements": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright (c) 2026 Leo Erdman. Licensed under the MIT License.",
        "NSMicrophoneUsageDescription": "Transcriptor records microphone audio when you start a live transcription.",
        "NSAppleEventsUsageDescription": "Transcriptor uses Apple Events to paste transcripts into the app you are working in."
      },
      "extraResources": [
        {
          "from": "runtime/mac-${arch}",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ],
      "target": [
        {
          "target": "mas",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signExecutable": false,
      "extraResources": [
        {
          "from": "runtime/win-x64",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "../requirements-gigaam.txt",
          "to": "requirements-gigaam.txt"
        },
        {
          "from": "../ENABLE_GIGAAM",
          "to": "ENABLE_GIGAAM"
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": "runtime/linux-x64",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        },
        {
          "from": "../requirements-gigaam.txt",
          "to": "requirements-gigaam.txt"
        },
        {
          "from": "../ENABLE_GIGAAM",
          "to": "ENABLE_GIGAAM"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Audio",
      "synopsis": "Voice-to-text transcription with auto-paste"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Transcriptor",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}

{
  "name": "transcriptor",
  "version": "1.1.25",
  "description": "Voice-to-text transcription with auto-paste",
  "author": "Transcriptor",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build:frontend": "npm --prefix ../frontend run build",
    "dist": "bash ./scripts/prepare-runtime.sh mac-arm64 && node ./unlockDist.js && npm run build:frontend && TRANSCRIPTOR_ALLOW_ADHOC_SIGN=${TRANSCRIPTOR_ALLOW_ADHOC_SIGN:-1} electron-builder --mac dmg --arm64",
    "dist:dir": "bash ./scripts/prepare-runtime.sh mac-arm64 && node ./unlockDist.js && npm run build:frontend && TRANSCRIPTOR_ALLOW_ADHOC_SIGN=${TRANSCRIPTOR_ALLOW_ADHOC_SIGN:-1} electron-builder --mac --dir --arm64",
    "dist:win": "bash ./scripts/prepare-runtime.sh win-x64 && node ./unlockDist.js && npm run build:frontend && electron-builder --win --x64",
    "dist:linux": "bash ./scripts/prepare-runtime.sh linux-x64 && node ./unlockDist.js && npm run build:frontend && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "local.transcriptor.app",
    "productName": "Transcriptor",
    "afterPack": "./afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "icon.png",
      "icon.ico",
      "!runtime/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.ruff_cache/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "identity": null,
      "extraResources": [
        {
          "from": "runtime/mac-${arch}",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "Transcriptor",
      "signAndEditExecutable": false,
      "sign": null,
      "extraResources": [
        {
          "from": "runtime/win-x64",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": "runtime/linux-x64",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/__pycache__/**",
            "!**/*.pyc"
          ]
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Audio",
      "synopsis": "Voice-to-text transcription with auto-paste",
      "desktop": {
        "StartupWMClass": "Transcriptor"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Transcriptor",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID profile for nested helpers and frameworks, and for
	     the bundled Python runtime's Mach-O files. See
	     entitlements.mac.plist for why the library-validation
	     relaxations are absent here: with a real Developer ID
	     certificate every image in the bundle shares one non-empty Team
	     ID, which is what library validation asks for. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyd
.python-version
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / Frontend / Desktop
node_modules/
frontend/node_modules/
desktop/node_modules/
frontend/dist/
desktop/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data / logs / temp
data/*.log
data/*.pid
data/api_token.txt
data/config.json
data/uploads/
data/results/
*.log
*.pid
tmp/
temp/

# Stray bundled Electron main at repo root (accidentally written by older
# build scripts). Keep out of the tree so they don't get re-committed.
/main.js
/.tmp_app_main.js

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Build artifacts
*.tgz
*.zip
*.dmg
*.app

# Bundled Python runtimes assembled by desktop/scripts/prepare-runtime.sh.
# Each subdirectory is 100-600 MB and is ONLY needed at release build time.
# Catch every runtime/<anything>/ dir (new platforms are dropped in here by
# the script), plus the download cache.
desktop/runtime/
!desktop/scripts/prepare-runtime.sh

# electron-builder intermediate output
desktop/dist/
desktop/out/
desktop/build/
*.exe
*.AppImage
*.blockmap
*.snap
*.deb
*.rpm

# Signature + release staging
/dist/
release/
Release/
Transcriptor-Release-*/

# Backend caches / state (in case user opens a venv in-tree)
backend/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/

# macOS metadata
**/.DS_Store
**/__MACOSX/

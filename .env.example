# Transcriptor — Environment Variables
# Copy to .env and customize as needed.

# Data directory (config, recordings, API keys). Default: ~/Library/Application Support/Transcriptor
# TRANSCRIPTOR_DATA_DIR=

# API authentication token. Auto-generated on first run if not set.
# TRANSCRIPTOR_API_TOKEN=

# How long to keep transcription results (seconds). Default: 86400 (24h)
# TRANSCRIPTOR_RESULT_RETENTION_SEC=86400

# How long to keep live recovery data (seconds). Default: 86400 (24h)
# Aligned with the in-code default at backend/main.py:_env_int(
# "TRANSCRIPTOR_LIVE_RECOVERY_RETENTION_SEC", 86400). Previously this
# example claimed 3600 (1h) — a 24× drift. Setting 21600 here would
# CUT retention to 6h, not extend it like a user reading the old
# comment would have assumed.
# TRANSCRIPTOR_LIVE_RECOVERY_RETENTION_SEC=86400

# Override Python path for the backend. Default: auto-detect.
# PYTHON=

# Transcriptor — user-facing environment variables
#
# REFERENCE ONLY. Nothing in this project reads a .env file: there is no
# python-dotenv in either requirements file, no load_dotenv() in the
# backend, and desktop/main.js reads process.env directly. Copying this
# to .env has no effect on anything. Export these in the shell, launch
# agent, CI job or build script that starts the app — the build and
# signing variables below are read by the scripts in desktop/scripts,
# and the runtime ones by the backend process Electron spawns.

# Data directory for config, API token, results, recoveries, and recordings.
# Default: Electron userData / platform app support directory.
# TRANSCRIPTOR_DATA_DIR=

# API authentication token. Auto-generated on first run if unset.
# TRANSCRIPTOR_API_TOKEN=

# Preferred backend port. Electron falls back to a free port when busy.
# TRANSCRIPTOR_PORT=8321

# Deepgram host override for testing or regional routing.
# Default: api.deepgram.com
# TRANSCRIPTOR_DEEPGRAM_HOST=api.deepgram.com

# How long to keep transient transcription result files, in seconds.
# Default: 86400 (24h)
# TRANSCRIPTOR_RESULT_RETENTION_SEC=86400

# How long to keep live recovery data, in seconds.
# Default: 86400 (24h)
# TRANSCRIPTOR_LIVE_RECOVERY_RETENTION_SEC=86400

# ── Recorded-audio retention ────────────────────────────────────────
# Transcripts (.txt) are NEVER deleted by retention, at any age or
# count. These knobs only govern the audio file saved beside them.
#
# Live Capsule (voice notes): how many recordings keep their audio,
# newest first. Older takes keep their transcript and lose the audio.
# 0 keeps every recording's audio forever.
#
# Default: 100 (was 3). Three takes were gone within hours of a working
# day, and the audio is the only evidence a report of missing words can
# be checked against - the recordings behind the 2026-09-03 word-loss
# audit were deleted while it was being written. Live capture is 16 kHz
# mono PCM16, about 1.9 MB per minute, so 100 one-minute takes stay
# under 200 MB.
# TRANSCRIPTOR_LIVE_AUDIO_KEEP_COUNT=100

# Uploaded Media: how long the track extracted from an uploaded file is
# kept, in seconds. There is no count limit for uploads.
# 0 keeps every uploaded track forever.
# Default: 604800 (7 days)
# TRANSCRIPTOR_UPLOAD_AUDIO_RETENTION_SEC=604800

# How often the background audio-retention sweep runs, in seconds.
# Only age limits need it — count limits are enforced on every save.
# Default: 3600 (1h); backend clamps to a 60 s floor.
# TRANSCRIPTOR_AUDIO_RETENTION_SWEEP_SEC=3600

# Remote transcription chunk size, in seconds.
# Default: 900; clamped by backend to 60..3600.
# TRANSCRIPTOR_REMOTE_TRANSCRIBE_CHUNK_SEC=900

# Max raw remote fallback body when ffmpeg is unavailable, in bytes.
# Default: 8388608 (8 MiB)
# TRANSCRIPTOR_REMOTE_RAW_FALLBACK_MAX_BYTES=8388608

# Override Python executable for development/source runs.
# PYTHON=

# Local Whisper CPU threads.
# Default: auto based on CPU count.
# Clamped to 4-8; values outside that range are pulled into it.
# TRANSCRIPTOR_WHISPER_CPU_THREADS=

# Local Whisper worker count.
# Default: auto based on CPU count.
# Clamped to 1-3; values outside that range are pulled into it.
# TRANSCRIPTOR_WHISPER_NUM_WORKERS=

# Local Whisper model cache size.
# Default: 2
# TRANSCRIPTOR_WHISPER_CACHE_SIZE=2

# Max simultaneously-resident GigaAM models. Torch weights are ~1 GB
# each, which is why the default is tighter than the Whisper one.
# Default: 1 (minimum 1)
# TRANSCRIPTOR_GIGAAM_CACHE_SIZE=1

# Deepgram transcript formatting. These apply to BOTH the live and the
# pre-recorded endpoint (backend/deepgram_format.py is the one builder),
# so changing one changes every request the app makes.
# Smart formatting — numbers, dates, currency written as a person would.
# Default: true
# TRANSCRIPTOR_DEEPGRAM_SMART_FORMAT=true
# Sentence punctuation and capitalisation.
# Default: true
# TRANSCRIPTOR_DEEPGRAM_PUNCTUATE=true
# Keep filler words ("um", "uh") in the transcript.
# Default: false
# TRANSCRIPTOR_DEEPGRAM_FILLER_WORDS=false

# Seconds a loaded local model may sit unused before it is released.
# A resident model holds ~700 MB; the cache-size cap above only evicts
# when a NEW model is loaded, so without this a single local
# transcription pinned that memory until the app quit. The next request
# reloads (a few seconds, off the interactive path). 0 disables.
# Default: 600
# TRANSCRIPTOR_WHISPER_IDLE_UNLOAD_SEC=600

# Source-media stability probe before from-path transcription starts, in ms.
# Default: 450; backend clamps to 50..2000.
# TRANSCRIPTOR_SOURCE_MEDIA_STABILITY_PROBE_MS=450

# Renderer trace logs for packaged-app diagnostics.
# Default: off; development mode enables renderer trace logging automatically.
# TRANSCRIPTOR_RENDERER_TRACE_LOGS=0

# macOS install target override for BUILD.command / INSTALL_ON_OTHER_MAC.command.
# Default: /Applications
# TRANSCRIPTOR_INSTALL_DIR=/Applications

# Target-Mac installer bundle-id assertion override.
# Default: local.transcriptor.app for internal/ad-hoc builds.
# TRANSCRIPTOR_EXPECTED_BUNDLE_ID=local.transcriptor.app

# Skip opening the app after INSTALL_ON_OTHER_MAC.command finishes.
# Default: 0
# TRANSCRIPTOR_SKIP_OPEN=0

# Developer ID signing identity for public macOS DMG builds.
# Notarization and stapling are still required before public distribution.
# TRANSCRIPTOR_SIGNING_IDENTITY="Developer ID Application: Your Team (TEAMID)"

# Public DMG notarization inputs. Run `npm --prefix desktop run notarize:dmg`
# after a Developer ID-signed DMG build. Prefer a stored notarytool keychain
# profile created with `xcrun notarytool store-credentials`.
# TRANSCRIPTOR_DMG_PATH=/absolute/path/Transcriptor-<version>-arm64.dmg
# TRANSCRIPTOR_APP_PATH=/absolute/path/Transcriptor.app
# TRANSCRIPTOR_NOTARY_WAIT_TIMEOUT=45m
# NOTARYTOOL_KEYCHAIN_PROFILE=TranscriptorNotaryProfile
# NOTARYTOOL_KEYCHAIN=/absolute/path/login.keychain-db
# Or use App Store Connect API key credentials:
# NOTARYTOOL_KEY=/absolute/path/AuthKey_KEYID.p8
# NOTARYTOOL_KEY_ID=KEYID
# NOTARYTOOL_ISSUER=ISSUER-UUID
# Or use Apple ID credentials:
# NOTARYTOOL_APPLE_ID=apple-id@example.com
# NOTARYTOOL_TEAM_ID=TEAMID
# NOTARYTOOL_PASSWORD=app-specific-password

# Explicit local-only ad-hoc signing opt-in.
# Default: unset; use npm --prefix desktop run dist:adhoc for local ad-hoc builds.
# TRANSCRIPTOR_ALLOW_ADHOC_SIGN=1

# Mac App Store / TestFlight build inputs. The provisioning profile must match
# TRANSCRIPTOR_MAS_APP_ID and include the App Sandbox entitlement.
# TRANSCRIPTOR_MAS_APP_ID=com.yourcompany.transcriptor
# TRANSCRIPTOR_MAS_PROVISIONING_PROFILE=/absolute/path/Transcriptor_Mac_App_Store.provisionprofile
# TRANSCRIPTOR_MAS_SIGNING_IDENTITY="Apple Distribution: Your Team (TEAMID)"
# TRANSCRIPTOR_MAS_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Your Team (TEAMID)"

# Optional MAS package path override used by sign/upload scripts.
# Default: desktop/dist/Transcriptor-<version>-mas-arm64.pkg
# TRANSCRIPTOR_MAS_PKG_PATH=/absolute/path/Transcriptor-<version>-mas-arm64.pkg

# App Store Connect upload credentials. Prefer API key + issuer.
# ASC_API_KEY=
# ASC_API_ISSUER=
# Optional explicit path to the App Store Connect API private key.
# If unset, altool searches its default AuthKey_<key>.p8 locations.
# ASC_API_KEY_PATH=/absolute/path/AuthKey_KEYID.p8
# Optional provider public id for Apple accounts with multiple providers.
# ASC_PROVIDER_PUBLIC_ID=
# ASC_USERNAME=
# ASC_APP_SPECIFIC_PASSWORD=

# Internal variables intentionally not documented as user settings:
# TRANSCRIPTOR_BOOT_NONCE, TRANSCRIPTOR_PARENT_WATCHDOG,
# TRANSCRIPTOR_DISABLE_PARENT_WATCHDOG, TRANSCRIPTOR_MAS_EXTERNAL_SIGN,
# TRANSCRIPTOR_MAS_APP_PATH.

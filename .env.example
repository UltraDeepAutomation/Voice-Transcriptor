# Transcriptor — user-facing environment variables
# Copy to .env and customize only the values you need.

# Data directory for config, API token, results, recoveries, and recordings.
# Default: Electron userData / platform app support directory.
# TRANSCRIPTOR_DATA_DIR=

# API authentication token. Auto-generated on first run if unset.
# TRANSCRIPTOR_API_TOKEN=

# Preferred backend port. Electron falls back to a free port when busy.
# TRANSCRIPTOR_PORT=8321

# Deepgram host override for testing or regional routing.
# Default: api.deepgram.com
# TRANSCRIPTOR_DEEPGRAM_HOST=api.deepgram.com

# How long to keep transient transcription result files, in seconds.
# Default: 86400 (24h)
# TRANSCRIPTOR_RESULT_RETENTION_SEC=86400

# How long to keep live recovery data, in seconds.
# Default: 86400 (24h)
# TRANSCRIPTOR_LIVE_RECOVERY_RETENTION_SEC=86400

# Remote transcription chunk size, in seconds.
# Default: 900; clamped by backend to 60..3600.
# TRANSCRIPTOR_REMOTE_TRANSCRIBE_CHUNK_SEC=900

# Max raw remote fallback body when ffmpeg is unavailable, in bytes.
# Default: 8388608 (8 MiB)
# TRANSCRIPTOR_REMOTE_RAW_FALLBACK_MAX_BYTES=8388608

# Override Python executable for development/source runs.
# PYTHON=

# Local Whisper CPU threads.
# Default: auto based on CPU count.
# TRANSCRIPTOR_WHISPER_CPU_THREADS=

# Local Whisper worker count.
# Default: auto based on CPU count.
# TRANSCRIPTOR_WHISPER_NUM_WORKERS=

# Local Whisper model cache size.
# Default: 2
# TRANSCRIPTOR_WHISPER_CACHE_SIZE=2

# Source-media stability probe before from-path transcription starts, in ms.
# Default: 450; backend clamps to 50..2000.
# TRANSCRIPTOR_SOURCE_MEDIA_STABILITY_PROBE_MS=450

# Renderer trace logs for packaged-app diagnostics.
# Default: off; development mode enables renderer trace logging automatically.
# TRANSCRIPTOR_RENDERER_TRACE_LOGS=0

# macOS install target override for BUILD.command / INSTALL_ON_OTHER_MAC.command.
# Default: /Applications
# TRANSCRIPTOR_INSTALL_DIR=/Applications

# Target-Mac installer bundle-id assertion override.
# Default: local.transcriptor.app for internal/ad-hoc builds.
# TRANSCRIPTOR_EXPECTED_BUNDLE_ID=local.transcriptor.app

# Skip opening the app after INSTALL_ON_OTHER_MAC.command finishes.
# Default: 0
# TRANSCRIPTOR_SKIP_OPEN=0

# Developer ID signing identity for public macOS DMG builds.
# Notarization and stapling are still required before public distribution.
# TRANSCRIPTOR_SIGNING_IDENTITY="Developer ID Application: Your Team (TEAMID)"

# Explicit local-only ad-hoc signing opt-in.
# Default: unset; use npm --prefix desktop run dist:adhoc for local ad-hoc builds.
# TRANSCRIPTOR_ALLOW_ADHOC_SIGN=1

# Mac App Store / TestFlight build inputs. The provisioning profile must match
# TRANSCRIPTOR_MAS_APP_ID and include the App Sandbox entitlement.
# TRANSCRIPTOR_MAS_APP_ID=com.yourcompany.transcriptor
# TRANSCRIPTOR_MAS_PROVISIONING_PROFILE=/absolute/path/Transcriptor_Mac_App_Store.provisionprofile
# TRANSCRIPTOR_MAS_SIGNING_IDENTITY="Apple Distribution: Your Team (TEAMID)"
# TRANSCRIPTOR_MAS_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Your Team (TEAMID)"

# Optional MAS package path override used by sign/upload scripts.
# Default: desktop/dist/Transcriptor-<version>-mas-arm64.pkg
# TRANSCRIPTOR_MAS_PKG_PATH=/absolute/path/Transcriptor-<version>-mas-arm64.pkg

# App Store Connect upload credentials. Prefer API key + issuer.
# ASC_API_KEY=
# ASC_API_ISSUER=
# ASC_USERNAME=
# ASC_APP_SPECIFIC_PASSWORD=

# Internal variables intentionally not documented as user settings:
# TRANSCRIPTOR_BOOT_NONCE, TRANSCRIPTOR_PARENT_WATCHDOG,
# TRANSCRIPTOR_DISABLE_PARENT_WATCHDOG, TRANSCRIPTOR_MAS_EXTERNAL_SIGN,
# TRANSCRIPTOR_MAS_APP_PATH.
